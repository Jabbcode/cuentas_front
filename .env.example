# Must match the PORT configured in the backend's .env (default: 4000)
VITE_API_URL=http://localhost:4000/api

# Sentry DSN — only active in production (VITE_SENTRY_DSN must be set in Vercel env vars)
VITE_SENTRY_DSN=

# Sentry source maps upload (build-time only, set in Vercel env vars)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
